# FLINT Frontend Environment Variables
# In Vercel Project Settings > Environment Variables, configure:
# VITE_API_URL: Your deployed backend API URL (e.g., https://your-backend.onrender.com or https://your-backend.railway.app)
VITE_API_URL=http://localhost:8000

# MapLibre GL Dark Geographic Basemap Tile Style URL
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
