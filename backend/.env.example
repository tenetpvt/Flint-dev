# FLINT Backend Environment Variables
# Database connection string (SQLite for local testing or PostgreSQL/Supabase for cloud deployment)
DATABASE_URL=sqlite:///./flint.db
# DATABASE_URL=postgresql://flint:password@host:5432/flint

# Allowed CORS origins (comma-separated). Note: Vercel (*.vercel.app) preview/production domains are automatically matched via regex!
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://flint-sih.vercel.app

# Google Gemini VLM Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash
VLM_PROVIDER=gemini

# Future Private VLM Configuration (Air-Gapped / Sovereign Deployments)
# PRIVATE_VLM_URL=http://127.0.0.1:11434/api/generate
# PRIVATE_VLM_MODEL=qwen2.5vl:3b
